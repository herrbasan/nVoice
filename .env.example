# nVoice Service Configuration

# Required: The STT adapter backend to use
NVOICE_ENGINE=sherpa_onnx

# Required: Directory to store large STT engine weights
# Per-engine model dirs: venv/<engine>/models/
NVOICE_MODEL_DIR=venv/sherpa_onnx/models/sherpa-onnx-streaming-zipformer-en-2023-06-21

# Model configuration (legacy: faster-whisper)
NVOICE_DEFAULT_MODEL_SIZE=large-v3
NVOICE_DEFAULT_DEVICE=cuda
NVOICE_DEFAULT_COMPUTE_TYPE=float16
NVOICE_DEFAULT_BEAM_SIZE=5

# sherpa-onnx streaming model files (relative to NVOICE_MODEL_DIR)
NVOICE_SHERPA_ENCODER=encoder-epoch-99-avg-1.int8.onnx
NVOICE_SHERPA_DECODER=decoder-epoch-99-avg-1.onnx
NVOICE_SHERPA_JOINER=joiner-epoch-99-avg-1.int8.onnx
NVOICE_SHERPA_PROVIDER=cpu
NVOICE_SHERPA_NUM_THREADS=4
NVOICE_SHERPA_ENABLE_ENDPOINT=true
NVOICE_SHERPA_RULE1_SILENCE=1.5
NVOICE_SHERPA_RULE2_SILENCE=0.8
NVOICE_SHERPA_RULE3_LENGTH=20.0

# Server Bindings
NVOICE_HOST=0.0.0.0
NVOICE_PORT=2245

# Auth Token (Optional)
NVOICE_API_KEY=

# Lifecycle
NVOICE_PRELOAD_MODEL=false
NVOICE_MODEL_IDLE_TIMEOUT_SEC=0
NVOICE_LOG_LEVEL=INFO

# Audio Limits
NVOICE_MAX_AUDIO_SECONDS=30
NVOICE_SAMPLE_RATE=16000

# LLM Gateway (for transcription enhancement)
NVOICE_LLM_GATEWAY_URL=http://your-llm-gateway:3400
NVOICE_LLM_MODEL=badkid-llama-chat
NVOICE_LLM_MAX_SEGMENTS=8
NVOICE_LLM_ENABLED=true
NVOICE_LLM_MODE=creative  # 0-2=exact, 3-7=balanced, 8-10=creative

# VAD Settings (Voice Activity Detection)
NVOICE_VAD_ENABLED=true
NVOICE_VAD_THRESHOLD=0.5
NVOICE_VAD_MIN_SPEECH_MS=250
NVOICE_VAD_MAX_SPEECH_MS=60000
NVOICE_VAD_SPEECH_WINDOWS=2
NVOICE_VAD_SILENCE_WINDOWS=8
NVOICE_VAD_MIN_CHUNK_MS=500

# Audio Recording (for debugging)
NVOICE_RECORD_RAW=true
NVOICE_RECORD_DIR=models/recordings

# LLM Gateway (for transcription enhancement)

# Logging
NVOICE_LOG_DIR=logs
